{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commonplace-log",
  "main": "src/index.ts",
  // Newest date supported by the workerd pinned by @cloudflare/vitest-pool-workers 0.12.21
  // (workerd 1.20260310.1).
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // Development deployment only. This must be "" or absent in every other deployment.
  "vars": { "REALM_TEST_LEVERS": "1" },
  // BACKUP-1b-i: the realm registry. Created 2026-09-05 by boss-clod under the deploy order at
  // commonplace-plan docs/plans/orders/2026-09-05-BACKUP-1b-i-deploy-order.md.
  // Every VALUE in this namespace is a realm read capability: the id may be recorded, no value may.
  "kv_namespaces": [
    { "binding": "REALM_REGISTRY", "id": "98aa81a3f3e644d6a6893eeefdd779d5" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COMMONPLACE_LOG", "class_name": "CommonplaceLog" },
      { "name": "REALM_CONTAINER", "class_name": "RealmContainer" },
      { "name": "REALM_NODE", "class_name": "RealmNode" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CommonplaceLog"] },
    { "tag": "v2", "new_sqlite_classes": ["RealmContainer"] },
    { "tag": "v3", "new_sqlite_classes": ["RealmNode"] }
  ],
  "containers": [
    {
      "name": "commonplace-log-realm",
      "class_name": "RealmNode",
      "image": "../commonplace_log/Dockerfile",
      "image_build_context": "../commonplace_log",
      // Bump to force a rollout; the Dockerfile turns it into a label only.
      "image_vars": { "BUILD_STAMP": "2026-08-25T20-entryv2" },
      // Deliberate capacity for the development deployment; not a production sizing claim.
      "max_instances": 10,
      "instance_type": "lite",
      // Keep the displaced incarnation alive for two minutes while its replacement starts;
      // this rollout overlap is the condition fenced by the durable lease epoch.
      "rollout_active_grace_period": 120
    }
  ]
}

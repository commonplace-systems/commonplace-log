{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commonplace-log-real-socket-integration",
  "main": "test/real-socket-worker.mjs",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "REALM_CONTAINER", "class_name": "RealmContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealmContainer"] }
  ]
}
